<Application x:Class="MksStudio.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:MksStudio.UI.Converters"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter"/>
            <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
            <converters:EnumToVisibilityConverter x:Key="EnumToVisibilityConverter"/>

            <!-- Color Palette & Custom Accents -->
            <SolidColorBrush x:Key="BgDark" Color="#0D0D11"/>
            <SolidColorBrush x:Key="BgPanel" Color="#141419"/>
            <SolidColorBrush x:Key="BgCard" Color="#1B1B22"/>
            <SolidColorBrush x:Key="BgCardElevated" Color="#23232C"/>
            <SolidColorBrush x:Key="BgHover" Color="#2D2D38"/>
            <SolidColorBrush x:Key="BgInput" Color="#111116"/>
            <SolidColorBrush x:Key="BorderDark" Color="#282834"/>
            <SolidColorBrush x:Key="BorderLight" Color="#3B3B4C"/>
            
            <!-- Accents -->
            <SolidColorBrush x:Key="AccentPrimary" Color="#38BDF8"/>
            <SolidColorBrush x:Key="AccentPrimaryHover" Color="#7DD3FC"/>
            <SolidColorBrush x:Key="AccentIndigo" Color="#6366F1"/>
            <SolidColorBrush x:Key="AccentPurple" Color="#A855F7"/>
            <SolidColorBrush x:Key="AccentGreen" Color="#22C55E"/>
            <SolidColorBrush x:Key="AccentAmber" Color="#F59E0B"/>
            <SolidColorBrush x:Key="AccentRed" Color="#EF4444"/>

            <!-- Text Colors -->
            <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
            <SolidColorBrush x:Key="TextSecondary" Color="#94A3B8"/>
            <SolidColorBrush x:Key="TextMuted" Color="#64748B"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<ui:FluentWindow x:Class="MksStudio.UI.Views.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MksStudio.UI.ViewModels"
        mc:Ignorable="d"
        Title="Translate Subtitles (Google Translate)" Height="680" Width="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="../app.ico"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable, Segoe UI">

    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- TitleBar -->
            <RowDefinition Height="*"/>    <!-- Content -->
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Translate Subtitles (Google Translate)" Icon="../app.ico" Height="44" Padding="12,0,8,0"/>

        <Grid Grid.Row="1" Margin="26,12,26,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Language Selection Card -->
                <RowDefinition Height="Auto"/> <!-- Scope & Destination Options -->
                <RowDefinition Height="*"/>    <!-- Progress & Live Preview -->
                <RowDefinition Height="Auto"/> <!-- Footer Actions -->
            </Grid.RowDefinitions>

            <!-- 1. Header -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="44" Height="44" Background="#1E1B4B" CornerRadius="12" Margin="0,0,14,0">
                    <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="22" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Online Subtitle Translator (Google Translate)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Instantly translate subtitles with 100% ASS, SRT, and VTT tag protection." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>
            </Grid>

            <!-- 2. Language Selection Card -->
            <ui:Card Grid.Row="1" Padding="18,14" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Source Language -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Source Language:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding SourceLanguages}"
                                  SelectedItem="{Binding SelectedSourceLanguage}"
                                  DisplayMemberPath="FullDisplay"
                                  IsEnabled="{Binding IsTranslating, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                  Height="34" Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>

                    <!-- Arrow Indicator -->
                    <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight24" FontSize="18" Foreground="{StaticResource AccentPrimary}"
                                   VerticalAlignment="Center" Margin="14,18,14,0"/>

                    <!-- Target Language -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Target Language:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                        <ComboBox ItemsSource="{Binding TargetLanguages}"
                                  SelectedItem="{Binding SelectedTargetLanguage}"
                                  DisplayMemberPath="FullDisplay"
                                  IsEnabled="{Binding IsTranslating, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                                  Height="34" Background="{StaticResource BgInput}" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- 3. Scope & Destination Options -->
            <ui:Card Grid.Row="2" Padding="18,14" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Scope Selection -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Cue Scope:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                        <RadioButton Content="Entire Active Track"
                                     IsChecked="{Binding SelectedScopeIndex, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=0, FallbackValue=True}"
                                     GroupName="ScopeGroup" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"
                                     IsEnabled="{Binding IsTranslating, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"/>
                        <RadioButton Content="Selected Cues Only"
                                     IsChecked="{Binding SelectedScopeIndex, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=1}"
                                     GroupName="ScopeGroup" Foreground="{StaticResource TextPrimary}"
                                     IsEnabled="{Binding IsTranslating, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"/>
                    </StackPanel>

                    <!-- Destination Selection -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Translation Destination:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,8"/>
                        <RadioButton Content="Create New Track (Recommended)"
                                     IsChecked="{Binding SelectedDestinationIndex, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=0, FallbackValue=True}"
                                     GroupName="DestGroup" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"
                                     IsEnabled="{Binding IsTranslating, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"/>
                        <RadioButton Content="Overwrite Current Track"
                                     IsChecked="{Binding SelectedDestinationIndex, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=1}"
                                     GroupName="DestGroup" Foreground="{StaticResource TextPrimary}"
                                     IsEnabled="{Binding IsTranslating, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"/>
                    </StackPanel>
                </Grid>
            </ui:Card>

            <!-- 4. Progress & Live Preview -->
            <ui:Card Grid.Row="3" Padding="16,14" Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderDark}" Margin="0,0,0,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Status Text & Percentage -->
                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <TextBlock Text="{Binding ProgressStatusText}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ProgressPercent, StringFormat={}{0:0}%}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}"/>
                    </Grid>

                    <!-- Progress Bar -->
                    <ProgressBar Grid.Row="1" Value="{Binding ProgressPercent}" Maximum="100" Height="6" Margin="0,0,0,10"
                                 Foreground="{StaticResource AccentPrimary}" Background="{StaticResource BgDark}"/>

                    <!-- Live Preview of Current Text -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{StaticResource BgDark}" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Original Text:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CurrentOriginalPreview}" FontSize="11" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" MaxHeight="55" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Background="{StaticResource BgDark}" CornerRadius="6" Padding="8">
                            <StackPanel>
                                <TextBlock Text="Translated Text:" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding CurrentTranslatedPreview}" FontSize="11" Foreground="{StaticResource TextPrimary}" TextWrapping="Wrap" MaxHeight="55" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </ui:Card>

            <!-- 5. Footer Actions -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Cancel during translation -->
                <ui:Button Grid.Column="0" Content="Cancel Process"
                           Command="{Binding CancelTranslationCommand}"
                           Appearance="Danger"
                           Visibility="{Binding IsTranslating, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                           FontWeight="SemiBold" Padding="16,8" Icon="{ui:SymbolIcon Symbol=Dismiss24}"/>

                <!-- Close button (when not translating) -->
                <ui:Button Grid.Column="0" Content="Close"
                           Click="OnCloseClicked"
                           Visibility="{Binding IsTranslating, Converter={StaticResource InverseBooleanToVisibilityConverter}, FallbackValue=Visible}"
                           Padding="18,9"/>

                <!-- Start Button -->
                <ui:Button Grid.Column="2" Content="Start Translation"
                           Click="OnStartTranslationClicked"
                           IsEnabled="{Binding IsTranslating, Converter={StaticResource InverseBooleanConverter}, FallbackValue=True}"
                           Appearance="Primary" FontWeight="Bold" FontSize="13" Padding="22,10" Icon="{ui:SymbolIcon Symbol=Flash24}"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>

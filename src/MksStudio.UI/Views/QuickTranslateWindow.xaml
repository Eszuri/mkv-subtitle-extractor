<ui:FluentWindow x:Class="MksStudio.UI.Views.QuickTranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MksStudio.UI.ViewModels"
        mc:Ignorable="d"
        Title="{Binding FileName}"
        Height="480" Width="680"
        MinHeight="360" MinWidth="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Icon="../app.ico"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable, Segoe UI">

    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="{Binding FileName}" Icon="../app.ico" Height="38" Padding="12,0,8,0"/>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20,10,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Language Selection Card -->
            <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14,12"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Source: Auto Detect -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Source Language" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <Border Background="#1E293B" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10,0" Height="32">
                            <TextBlock Text="Auto Detect" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>

                    <!-- Arrow -->
                    <TextBlock Grid.Column="1" Text="➔" FontSize="16" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="14,14,14,0"/>

                    <!-- Target Language Dropdown -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Target Language" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding TargetLanguages}"
                                  SelectedItem="{Binding SelectedTargetLanguage}"
                                  DisplayMemberPath="FullDisplay"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                  Height="32" FontSize="12"
                                  VerticalContentAlignment="Center"
                                  Padding="10,0,28,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Preview Area (visible after pressing translate) -->
            <Grid Grid.Row="1" Margin="0,10,0,0"
                  Visibility="{Binding IsPreviewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Progress Header (while translating) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,8"
                            Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid Margin="0,0,0,4">
                        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource AccentPrimary}"/>
                        <TextBlock Text="{Binding ProgressPercent, StringFormat='{}{0:0}%'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="4" Foreground="{StaticResource AccentPrimary}" Background="#1E293B" BorderThickness="0"/>
                </StackPanel>

                <!-- Status Header (when translation finished) -->
                <TextBlock Grid.Row="0" Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,8"
                           Foreground="{StaticResource AccentGreen}"
                           Visibility="{Binding IsCompleted, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                <!-- Two-Column Preview Table: Original Text vs Translated Text (No timeline) -->
                <Border Grid.Row="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Table Header -->
                        <Border Grid.Row="0" Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" CornerRadius="7,7,0,0" Padding="14,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Original Text" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}"/>
                                <TextBlock Grid.Column="1" Text="Translated Text" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}" Margin="12,0,0,0"/>
                            </Grid>
                        </Border>

                        <!-- Virtualized List of Cues -->
                        <ListBox x:Name="PreviewListBox"
                                 Grid.Row="1"
                                 ItemsSource="{Binding PreviewItems}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 VirtualizingPanel.VirtualizationMode="Recycling"
                                 Focusable="False">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Focusable" Value="False"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:QuickTranslatePreviewItem}">
                                    <Border BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="14,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Original Text -->
                                            <TextBlock Grid.Column="0" Text="{Binding OriginalText}" TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource TextPrimary}" Margin="0,0,8,0"/>

                                            <!-- Translated Text -->
                                            <TextBlock Grid.Column="1" Text="{Binding TranslatedText}" TextWrapping="Wrap" FontSize="11.5" Foreground="#38BDF8" Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Actions Footer -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                    <Button Content="Translate" Height="32" Padding="18,0" Margin="0,0,8,0"
                            Background="#162A45" BorderBrush="#0284C7" BorderThickness="1" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11.5"
                            Command="{Binding StartTranslationCommand}"/>

                    <Button Content="Cancel" Height="32" Padding="14,0"
                            Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Foreground="{StaticResource TextMuted}" FontSize="11.5"
                            Command="{Binding CancelOrCloseCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>

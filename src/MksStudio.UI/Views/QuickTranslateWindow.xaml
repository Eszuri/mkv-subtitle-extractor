<ui:FluentWindow x:Class="MksStudio.UI.Views.QuickTranslateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MksStudio.UI.ViewModels"
        mc:Ignorable="d"
        Title="{Binding FileName}"
        Height="360" Width="680"
        MinHeight="280" MinWidth="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Icon="../app.ico"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable, Segoe UI">

    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="{Binding FileName}" Icon="../app.ico" Height="38" Padding="12,0,8,0"/>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20,10,20,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Language Selection Card -->
            <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="14,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Source: Auto Detect -->
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="Bahasa Asli" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <Border Background="#1E293B" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="4" Padding="10,6">
                            <TextBlock Text="Auto Detect" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        </Border>
                    </StackPanel>

                    <!-- Arrow -->
                    <TextBlock Grid.Column="1" Text="➔" FontSize="16" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="14,14,14,0"/>

                    <!-- Target Language Dropdown -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="Bahasa Target" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding TargetLanguages}"
                                  SelectedItem="{Binding SelectedTargetLanguage}"
                                  DisplayMemberPath="FullDisplay"
                                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                                  Height="32" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progress Area -->
            <Border Grid.Row="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource AccentPrimary}" Margin="0,0,0,6"/>
                    <ProgressBar Value="{Binding ProgressPercent}" Maximum="100" Height="5" Foreground="{StaticResource AccentPrimary}" Background="#1E293B" BorderThickness="0"/>
                    <TextBlock Text="{Binding CurrentPreview}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Bottom Actions Footer -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Terjemahkan" Height="32" Padding="18,0" Margin="0,0,8,0"
                            Background="#162A45" BorderBrush="#0284C7" BorderThickness="1" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11.5"
                            Command="{Binding StartTranslationCommand}"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"/>

                    <Button Content="Batal" Height="32" Padding="14,0"
                            Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" Foreground="{StaticResource TextMuted}" FontSize="11.5"
                            Command="{Binding CancelOrCloseCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>

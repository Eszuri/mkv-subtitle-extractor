<Window x:Class="MksStudio.UI.Views.CustomColorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Select Custom Subtitle Color"
        Width="490" Height="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Background="#0F131A"
        Foreground="#E2E8F0">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title & Info -->
            <RowDefinition Height="Auto"/> <!-- Cinema Live Swatch -->
            <RowDefinition Height="Auto"/> <!-- Preset Grid -->
            <RowDefinition Height="*"/>    <!-- RGB & Hex controls -->
            <RowDefinition Height="Auto"/> <!-- Actions -->
        </Grid.RowDefinitions>

        <!-- 1. Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="CUSTOM SUBTITLE COLOR PALETTE" FontWeight="Bold" FontSize="13" Foreground="#38BDF8"/>
            <TextBlock Text="Select a preset color or specify custom RGB / Hex values." FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- 2. Cinema Preview Banner -->
        <Border Grid.Row="1" Background="#05070B" BorderBrush="#252C3A" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Subtitle text in selected color -->
                <TextBlock x:Name="PreviewTextBlock" Grid.Row="0" Text="Aa Cinema Subtitle Text 123"
                           FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center"
                           TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis" Margin="0,4,0,8"
                           Foreground="#FFFF00">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="4" ShadowDepth="2" Direction="315" Opacity="0.9"/>
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Technical tags HUD -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Border Background="#161C26" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                        <TextBlock x:Name="HexCodeText" Text="HEX: #FFFF00" FontSize="11" FontWeight="SemiBold" Foreground="#38BDF8"/>
                    </Border>
                    <Border Background="#161C26" CornerRadius="4" Padding="6,2">
                        <TextBlock x:Name="AssTagCodeText" Text="ASS TAG: {\c&amp;H00FFFF&amp;}" FontSize="11" FontWeight="SemiBold" Foreground="#FACC15"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. 32-Color Curated Grid -->
        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="QUICK PRESETS (32 COLORS):" FontSize="10" FontWeight="Bold" Foreground="#94A3B8" Margin="0,0,0,6"/>
            <WrapPanel x:Name="PaletteWrapPanel" Orientation="Horizontal"/>
        </StackPanel>

        <!-- 4. RGB Sliders & Hex Input -->
        <Border Grid.Row="3" Background="#161C26" BorderBrush="#252C3A" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="28"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>

                <!-- Red -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="R" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center"/>
                <Slider x:Name="SliderR" Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnSliderValueChanged" VerticalAlignment="Center" Margin="8,4"/>
                <TextBox x:Name="TextR" Grid.Row="0" Grid.Column="2" Text="{Binding Value, ElementName=SliderR, StringFormat='{}{0:F0}'}"
                         FontSize="11" HorizontalContentAlignment="Center" Background="#0F131A" Foreground="#FFFFFF" BorderBrush="#252C3A" VerticalAlignment="Center"/>

                <!-- Green -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="G" FontWeight="Bold" Foreground="#22C55E" VerticalAlignment="Center"/>
                <Slider x:Name="SliderG" Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnSliderValueChanged" VerticalAlignment="Center" Margin="8,4"/>
                <TextBox x:Name="TextG" Grid.Row="1" Grid.Column="2" Text="{Binding Value, ElementName=SliderG, StringFormat='{}{0:F0}'}"
                         FontSize="11" HorizontalContentAlignment="Center" Background="#0F131A" Foreground="#FFFFFF" BorderBrush="#252C3A" VerticalAlignment="Center"/>

                <!-- Blue -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="B" FontWeight="Bold" Foreground="#3B82F6" VerticalAlignment="Center"/>
                <Slider x:Name="SliderB" Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" ValueChanged="OnSliderValueChanged" VerticalAlignment="Center" Margin="8,4"/>
                <TextBox x:Name="TextB" Grid.Row="2" Grid.Column="2" Text="{Binding Value, ElementName=SliderB, StringFormat='{}{0:F0}'}"
                         FontSize="11" HorizontalContentAlignment="Center" Background="#0F131A" Foreground="#FFFFFF" BorderBrush="#252C3A" VerticalAlignment="Center"/>

                <!-- Hex Manual Input -->
                <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <TextBlock Text="Hex Code:" FontSize="11" Foreground="#94A3B8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox x:Name="HexInputBox" Width="90" Text="#FFFF00" FontSize="12" FontWeight="SemiBold"
                             Background="#0F131A" Foreground="#38BDF8" BorderBrush="#252C3A" TextChanged="OnHexInputTextChanged"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 5. Dialog Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Width="80" Height="32" Click="OnCancelClicked" Background="#161C26" BorderBrush="#252C3A" Foreground="#94A3B8" Margin="0,0,10,0"/>
            <Button Content="✓ Apply Color" Width="150" Height="32" Click="OnApplyClicked" Background="#0284C7" BorderBrush="#38BDF8" Foreground="#FFFFFF" FontWeight="Bold"/>
        </StackPanel>
    </Grid>
</Window>

<ui:FluentWindow x:Class="MksStudio.UI.Views.AttachmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Lampiran Font Embedded (TTF/OTF)" Height="540" Width="780"
        WindowStartupLocation="CenterOwner"
        Icon="../app.ico"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable, Segoe UI">

    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Lampiran Font Embedded (.mks)" Icon="../app.ico" Height="44" Padding="12,0,8,0"/>

        <Grid Grid.Row="1" Margin="26,12,26,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header & Action Buttons -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="🔤 Lampiran Font Embedded (TTF / OTF)" FontSize="16" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}"/>
                    <TextBlock Text="Font yang disematkan ke dalam .mks akan dimuat otomatis oleh subtitle renderer untuk tipografi presisi." FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <ui:Button Content="Tambah Font..." Padding="14,7" Appearance="Primary" Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=Add24}" Click="OnAddAttachmentClicked"/>
                    <ui:Button Content="Ekspor Font..." Padding="14,7" Appearance="Secondary" Margin="0,0,8,0" Icon="{ui:SymbolIcon Symbol=Share24}" Click="OnExportAttachmentClicked"/>
                    <ui:Button Content="Hapus" Padding="12,7" Appearance="Danger" Icon="{ui:SymbolIcon Symbol=Delete24}" Click="OnRemoveAttachmentClicked"/>
                </StackPanel>
            </Grid>

            <!-- DataGrid of Attachments -->
            <DataGrid Grid.Row="1" x:Name="AttachmentsGrid" ItemsSource="{Binding Attachments}" AutoGenerateColumns="False" CanUserAddRows="False"
                      Background="{StaticResource BgPanel}" Foreground="{StaticResource TextPrimary}" RowBackground="{StaticResource BgDark}" AlternatingRowBackground="{StaticResource BgPanel}"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderDark}" BorderBrush="{StaticResource BorderDark}" HeadersVisibility="Column" SelectionMode="Single">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="{StaticResource BgCardElevated}"/>
                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                        <Setter Property="Padding" Value="12,8"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nama File" Binding="{Binding FileName}" Width="240" IsReadOnly="False" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="Tipe MIME" Binding="{Binding FileMimeType}" Width="190" IsReadOnly="False"/>
                    <DataGridTextColumn Header="Ukuran" Binding="{Binding FileSizeFormatted}" Width="95" IsReadOnly="True" FontFamily="Consolas"/>
                    <DataGridTextColumn Header="Deskripsi" Binding="{Binding Description}" Width="*" IsReadOnly="False"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Bottom Close Button -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <ui:Button Content="Selesai" Width="110" Padding="0,8" Click="OnCloseClicked"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>

<ui:FluentWindow x:Class="MksStudio.UI.Views.TimeShiftWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        mc:Ignorable="d"
        Title="Time Shift &amp; FPS Converter" Height="480" Width="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Icon="../app.ico"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable, Segoe UI">

    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Time Shift &amp; FPS Converter" Icon="../app.ico" Height="44" Padding="12,0,8,0"/>

        <Grid Grid.Row="1" Margin="24,12,24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14" VerticalAlignment="Center">
                <Border Width="38" Height="38" Background="#1E1B4B" CornerRadius="10" Margin="0,0,12,0">
                    <ui:SymbolIcon Symbol="Clock24" FontSize="20" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Time Shift &amp; FPS Converter" FontSize="15" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                    <TextBlock Text="Sinkronisasi timestamp milidetik atau konversi framerate video." FontSize="11" Foreground="{StaticResource TextMuted}"/>
                </StackPanel>
            </StackPanel>

            <!-- Millisecond Shift Card -->
            <ui:Card Grid.Row="1" Padding="16,14" Margin="0,0,0,12" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}">
                <StackPanel>
                    <TextBlock Text="Pergeseran Waktu (Offset Milidetik):" Margin="0,0,0,6" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="11"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="OffsetBox" Text="{Binding OffsetMilliseconds, UpdateSourceTrigger=PropertyChanged}" Height="36" FontSize="13" FontFamily="Consolas, Segoe UI"/>
                        <TextBlock Grid.Column="1" Text="ms (+/-)" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="{StaticResource TextMuted}" FontWeight="SemiBold" FontSize="11"/>
                    </Grid>
                    <ui:Button Content="Terapkan Time Shift" Appearance="Primary" HorizontalAlignment="Stretch" Padding="0,8" FontWeight="SemiBold" Icon="{ui:SymbolIcon Symbol=Flash24}" Click="OnApplyShiftClicked"/>
                </StackPanel>
            </ui:Card>

            <!-- FPS Scaling Card -->
            <ui:Card Grid.Row="2" Padding="16,14" Margin="0,0,0,16" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}">
                <StackPanel>
                    <TextBlock Text="Skala Frame Rate (Konversi FPS):" Margin="0,0,0,6" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" FontSize="11"/>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="FPS Asal:" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                            <ui:TextBox Text="{Binding SourceFps, UpdateSourceTrigger=PropertyChanged}" Height="34" FontFamily="Consolas" FontSize="12"/>
                        </StackPanel>
                        <ui:SymbolIcon Grid.Column="1" Symbol="ArrowRight24" FontSize="16" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center" Margin="12,14,12,0"/>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="FPS Tujuan:" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,0,0,2"/>
                            <ui:TextBox Text="{Binding TargetFps, UpdateSourceTrigger=PropertyChanged}" Height="34" FontFamily="Consolas" FontSize="12"/>
                        </StackPanel>
                    </Grid>
                    <ui:Button Content="Konversi Frame Rate" Appearance="Secondary" HorizontalAlignment="Stretch" Padding="0,8" FontWeight="SemiBold" Icon="{ui:SymbolIcon Symbol=ArrowClockwise24}" Click="OnApplyFpsClicked"/>
                </StackPanel>
            </ui:Card>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Selesai" Width="100" Padding="0,8" Click="OnCloseClicked"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>

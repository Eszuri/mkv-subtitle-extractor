<ui:FluentWindow x:Class="MksStudio.UI.Views.QuickExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MksStudio.UI.ViewModels"
        mc:Ignorable="d"
        Title="{Binding FileName, StringFormat='Export Subtitle - {0}'}"
        Height="460" Width="680"
        MinHeight="340" MinWidth="520"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResizeWithGrip"
        Icon="../app.ico"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable, Segoe UI">

    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <ui:TitleBar Grid.Row="0" Title="{Binding FileName, StringFormat='Export Subtitle - {0}'}" Icon="../app.ico" Height="38" Padding="12,0,8,0"/>

        <!-- Selection Toolbar -->
        <Grid Grid.Row="1" Margin="14,0,14,6" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Select All" Height="26" Padding="10,0" Margin="0,0,6,0"
                        Background="#1E293B" BorderBrush="{StaticResource BorderDark}" BorderThickness="1"
                        Foreground="{StaticResource AccentPrimary}" FontSize="11" FontWeight="SemiBold"
                        Command="{Binding SelectAllCommand}" Cursor="Hand"/>
                <Button Content="Unselect All" Height="26" Padding="10,0"
                        Background="#1E293B" BorderBrush="{StaticResource BorderDark}" BorderThickness="1"
                        Foreground="{StaticResource TextMuted}" FontSize="11"
                        Command="{Binding UnselectAllCommand}" Cursor="Hand"/>
            </StackPanel>
        </Grid>

        <!-- Track List -->
        <Border Grid.Row="2" Margin="14,0,14,10" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="8" Padding="6"
                IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Tracks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:QuickExportTrackItem}">
                            <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox -->
                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,10,0"/>

                                    <!-- ID Badge -->
                                    <Border Grid.Column="1" Background="#1E1B4B" CornerRadius="4" Padding="6,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding BadgeText}" FontSize="10" FontWeight="Bold" Foreground="#818CF8"/>
                                    </Border>

                                    <!-- Track Information -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TitleDisplay}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding CodecDisplay}" FontSize="10" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Status Badges -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                                        <Border Background="#14532D" CornerRadius="4" Padding="5,1" Margin="0,0,4,0" Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="DEFAULT" FontSize="8.5" FontWeight="Bold" Foreground="#4ADE80"/>
                                        </Border>
                                        <Border Background="#7C2D12" CornerRadius="4" Padding="5,1" Visibility="{Binding IsForced, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <TextBlock Text="FORCED" FontSize="8.5" FontWeight="Bold" Foreground="#FB923C"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Bottom Actions Footer -->
        <Border Grid.Row="3" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Progress indicator when running in background -->
                <ProgressBar Grid.Column="0" IsIndeterminate="True" Height="4" Margin="0,0,14,0" VerticalAlignment="Center"
                             Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Foreground="{StaticResource AccentPrimary}" Background="#1E293B" BorderThickness="0"/>

                <!-- Action Buttons: Export .mks and Export .ass -->
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}">
                    <Button Content="Export .mks" Height="32" Padding="16,0" Margin="0,0,8,0"
                            Background="#162A45" BorderBrush="#0284C7" BorderThickness="1" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11.5"
                            Command="{Binding ExportMksCommand}"/>

                    <Button Content="Export .ass" Height="32" Padding="16,0"
                            Background="#163824" BorderBrush="#16A34A" BorderThickness="1" Foreground="#4ADE80" FontWeight="SemiBold" FontSize="11.5"
                            Command="{Binding ExportAssCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>

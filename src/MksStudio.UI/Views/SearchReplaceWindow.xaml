<Window x:Class="MksStudio.UI.Views.SearchReplaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Find &amp; Replace Subtitles" Height="320" Width="460"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource BgDark}" Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🔍 Find &amp; Replace" FontSize="18" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" Margin="0,0,0,16"/>

        <!-- Find Box -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Find:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource BgInput}" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderDark}" Padding="8,5"/>
        </Grid>

        <!-- Replace Box -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Replace:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
            <TextBox Grid.Column="1" Text="{Binding ReplaceText, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource BgInput}" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderDark}" Padding="8,5"/>
        </Grid>

        <!-- Options -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="80,0,0,12">
            <CheckBox Content="Match Case" IsChecked="{Binding MatchCase}" Foreground="{StaticResource TextPrimary}" Margin="0,0,20,0"/>
            <CheckBox Content="Use Regular Expression" IsChecked="{Binding UseRegex}" Foreground="{StaticResource TextPrimary}"/>
        </StackPanel>

        <!-- Status -->
        <TextBlock Grid.Row="4" Text="{Binding StatusText}" Foreground="{StaticResource AccentPrimary}" FontStyle="Italic" VerticalAlignment="Center" Margin="80,0,0,0"/>

        <!-- Buttons -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="🔍 Find Next" Padding="14,6" Background="{StaticResource AccentPrimary}" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" Click="OnFindNextClicked"/>
            <Button Content="✏️ Replace All" Padding="14,6" Background="{StaticResource AccentGreen}" Foreground="#FFFFFF" BorderThickness="0" Margin="0,0,8,0" Cursor="Hand" Click="OnReplaceAllClicked"/>
            <Button Content="Close" Padding="12,6" Background="{StaticResource BgCardElevated}" Foreground="#FFFFFF" BorderThickness="0" Cursor="Hand" Click="OnCloseClicked"/>
        </StackPanel>
    </Grid>
</Window>

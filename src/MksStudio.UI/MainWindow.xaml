<Window x:Class="MksStudio.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:MksStudio.UI.ViewModels"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="840" Width="1320"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnWindowDrop"
        Icon="app.ico"
        Background="{StaticResource BgDark}" Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top App Header & Nav Bar -->
            <RowDefinition Height="*"/>    <!-- Main View Switcher (Home / Editor / Extractor) -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Top Header & Navigation Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- App Brand -->
                    <ColumnDefinition Width="*"/>    <!-- Center Nav Pills -->
                    <ColumnDefinition Width="Auto"/> <!-- Quick Stats -->
                </Grid.ColumnDefinitions>

                <!-- Branding -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🎬" FontSize="20" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="MKS STUDIO" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentPrimary}"/>
                        <TextBlock Text="Matroska Subtitle Toolkit" FontSize="10" Foreground="{StaticResource TextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Tabs (Home / Editor / Extractor) -->
                <Border Grid.Column="1" HorizontalAlignment="Center" Background="{StaticResource BgDark}" CornerRadius="20" Padding="4" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <!-- Home Tab -->
                        <Button Content="🏠 Home" Command="{Binding NavigateToHomeCommand}" Padding="16,6" Margin="0,0,4,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewIndex}" Value="0">
                                            <Setter Property="Background" Value="{StaticResource BgCardElevated}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- MKS Editor Tab -->
                        <Button Content="✏️ MKS Subtitle Editor" Command="{Binding NavigateToEditorCommand}" Padding="16,6" Margin="0,0,4,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewIndex}" Value="1">
                                            <Setter Property="Background" Value="{StaticResource BgCardElevated}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- MKV Extractor Tab -->
                        <Button Content="🎬 MKV Subtitle Extractor" Command="{Binding NavigateToExtractorCommand}" Padding="16,6">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewIndex}" Value="2">
                                            <Setter Property="Background" Value="{StaticResource AccentPurple}"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- Right Pill Stats -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{StaticResource BgCard}" CornerRadius="12" Padding="8,4" Margin="0,0,6,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⏱ " FontSize="10" Foreground="{StaticResource AccentPrimary}"/>
                            <TextBlock Text="{Binding TotalDurationText}" Foreground="{StaticResource AccentPrimary}" FontWeight="Bold" FontSize="11"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{StaticResource BgCard}" CornerRadius="12" Padding="8,4" Margin="0,0,6,0" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                        <TextBlock Text="{Binding TotalTracksCount, StringFormat='{}📑 {0} Tracks'}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11"/>
                    </Border>

                    <Border Background="{StaticResource BgCard}" CornerRadius="12" Padding="8,4" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                        <TextBlock Text="{Binding TotalAttachmentsCount, StringFormat='{}🔤 {0} Fonts'}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="11"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body Switcher -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding CurrentViewIndex}" Background="Transparent" BorderThickness="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/> <!-- Hide standard tabs -->
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- ========================================== -->
            <!-- TAB 0: HOME SCREEN DASHBOARD               -->
            <!-- ========================================== -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="40,24,40,30" MaxWidth="1100">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Hero Header -->
                            <RowDefinition Height="Auto"/> <!-- 2 Main Option Cards -->
                            <RowDefinition Height="Auto"/> <!-- Drop Zone / Quick Info -->
                        </Grid.RowDefinitions>

                        <!-- Hero Header Section -->
                        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,32">
                            <Border Background="{StaticResource BgCardElevated}" HorizontalAlignment="Center" CornerRadius="16" Padding="12,4" Margin="0,0,0,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                <TextBlock Text="✨ Versi 1.0 Ready • MKVToolNix Engine Terintegrasi" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}"/>
                            </Border>
                            <TextBlock Text="MKS Subtitle Studio &amp; Demuxer" FontSize="32" FontWeight="Bold" Foreground="#FFFFFF" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                            <TextBlock Text="Pilih modul yang ingin Anda gunakan di bawah ini:" FontSize="15" Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- 2 Main Cards Grid -->
                        <Grid Grid.Row="1" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- ==================================================== -->
                            <!-- OPTION CARD 1: MKV SUBTITLE EXTRACTOR (PURPLE ACCENT) -->
                            <!-- ==================================================== -->
                            <Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="12" Padding="24" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Icon & Title -->
                                        <RowDefinition Height="Auto"/> <!-- Description -->
                                        <RowDefinition Height="*"/>    <!-- Feature Checklist -->
                                        <RowDefinition Height="Auto"/> <!-- Buttons -->
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                        <Border Width="52" Height="52" Background="#3B1D66" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <TextBlock Text="🎬" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="MKV Subtitle Extractor" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentPurple}"/>
                                        <TextBlock Text="Ekstrak Subtitle &amp; Font dari Video MKV" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Text="Ekstrak track subtitle (SRT, ASS, VTT, PGS) dan font secara instan dari file video MKV berkecepatan tinggi tanpa perlu re-encoding video/audio." FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,18"/>

                                    <!-- Features List -->
                                    <StackPanel Grid.Row="2" Margin="0,0,0,20">
                                        <TextBlock Text="✓ Ekstraksi berkecepatan tinggi (1–2 detik per video)" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" FontSize="12"/>
                                        <TextBlock Text="✓ Ekstrak ke SRT, ASS, VTT, PGS, atau langsung ke .mks" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" FontSize="12"/>
                                        <TextBlock Text="✓ Otomatis mengekstrak font embedded (TTF/OTF)" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" FontSize="12"/>
                                        <TextBlock Text="✓ Batch Folder Mode (proses 1 season serial anime sekaligus)" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Buttons -->
                                    <StackPanel Grid.Row="3">
                                        <Button Content="🚀 Buka MKV Extractor ➔" Command="{Binding NavigateToExtractorCommand}" Background="{StaticResource AccentPurple}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Padding="16,10" Margin="0,0,0,8" BorderThickness="0"/>
                                        <Button Content="📁 Pilih File Video .mkv..." Command="{Binding ExtractorVm.BrowseInputCommand}" Padding="14,8" Background="{StaticResource BgCardElevated}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- =================================================== -->
                            <!-- OPTION CARD 2: MKS SUBTITLE STUDIO (CYAN ACCENT)   -->
                            <!-- =================================================== -->
                            <Border Grid.Column="2" Background="{StaticResource BgPanel}" CornerRadius="12" Padding="24" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/> <!-- Icon & Title -->
                                        <RowDefinition Height="Auto"/> <!-- Description -->
                                        <RowDefinition Height="*"/>    <!-- Feature Checklist -->
                                        <RowDefinition Height="Auto"/> <!-- Buttons -->
                                    </Grid.RowDefinitions>

                                    <!-- Header -->
                                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                                        <Border Width="52" Height="52" Background="#0C3650" CornerRadius="12" HorizontalAlignment="Left" Margin="0,0,0,12">
                                            <TextBlock Text="✏️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="MKS Subtitle Studio" FontSize="20" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}"/>
                                        <TextBlock Text="Viewer, Editor &amp; Muxer File .mks" FontSize="12" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>

                                    <!-- Description -->
                                    <TextBlock Grid.Row="1" Text="Buka, inspeksi, edit baris subtitle, timecode, styling teks ASS, serta kelola multi-track dan font dalam satu container Matroska Subtitles (.mks)." FontSize="13" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,0,0,18"/>

                                    <!-- Features List -->
                                    <StackPanel Grid.Row="2" Margin="0,0,0,20">
                                        <TextBlock Text="✓ Manajemen multi-track subtitle (SRT, ASS, VTT)" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" FontSize="12"/>
                                        <TextBlock Text="✓ Virtualized DataGrid &amp; Filter Pencarian Real-time" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" FontSize="12"/>
                                        <TextBlock Text="✓ Time Shifting presisi (+/- ms) &amp; FPS Converter" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" FontSize="12"/>
                                        <TextBlock Text="✓ Live Cinema Preview 16:9 &amp; Quick Formatting Bar" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
                                    </StackPanel>

                                    <!-- Buttons -->
                                    <StackPanel Grid.Row="3">
                                        <Button Content="🚀 Buka MKS Editor ➔" Command="{Binding NavigateToEditorCommand}" Background="{StaticResource AccentPrimary}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Padding="16,10" Margin="0,0,0,8" BorderThickness="0"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="📂 Buka File..." Command="{Binding OpenFileCommand}" Padding="10,8" Background="{StaticResource BgCardElevated}"/>
                                            <Button Grid.Column="2" Content="➕ Buat Baru" Command="{Binding CreateNewFileCommand}" Padding="10,8" Background="{StaticResource BgCardElevated}"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- Drop Zone Card -->
                        <Border Grid.Row="2" Background="{StaticResource BgCard}" CornerRadius="10" Padding="20,16" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💡 " FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock Text="Tip Cepat: Anda dapat men-Drag &amp; Drop file " Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text=".mks" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center"/>
                                <TextBlock Text=" atau " Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                <TextBlock Text=".mkv" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center"/>
                                <TextBlock Text=" langsung ke layar ini untuk membukanya secara instan." Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 1: MKS SUBTITLE STUDIO (EDITOR/VIEWER) -->
            <!-- ========================================== -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Toolbar & Header -->
                        <RowDefinition Height="*"/>    <!-- Main Content -->
                    </Grid.RowDefinitions>

                    <!-- Action Toolbar & Container Header -->
                    <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="12,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Action Toolbar Buttons Grouped -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="📂 Open" Command="{Binding OpenFileCommand}" ToolTip="Open .mks or .mkv file" Margin="0,0,6,0"/>
                                <Button Content="💾 Save (.mks)" Command="{Binding SaveFileCommand}" Background="{StaticResource AccentGreen}" Foreground="#FFFFFF" ToolTip="Save directly to .mks (Ctrl+S)" Margin="0,0,6,0"/>
                                <Button Content="➕ Add Track" Command="{Binding AddTrackFromFileCommand}" ToolTip="Import subtitle file as track" Margin="0,0,10,0"/>

                                <Border Width="1" Background="{StaticResource BorderDark}" Margin="0,2,10,2"/>

                                <Button Content="⏱️ Time Shift" Click="OnOpenTimeShiftClicked" ToolTip="Shift timestamps or convert FPS" Margin="0,0,6,0"/>
                                <Button Content="🔍 Find/Replace" Click="OnOpenSearchReplaceClicked" ToolTip="Search and replace text" Margin="0,0,6,0"/>
                                <Button Content="🔤 Fonts" Click="OnOpenAttachmentsClicked" ToolTip="Manage embedded fonts" Margin="0,0,10,0"/>

                                <Border Width="1" Background="{StaticResource BorderDark}" Margin="0,2,10,2"/>

                                <Button Content="📤 Export Track" Command="{Binding ExportTrackCommand}" ToolTip="Export current track" Margin="0,0,6,0"/>
                                <Button Content="📦 Export All Tracks" Command="{Binding ExportAllTracksCommand}" ToolTip="Export all tracks to folder" Margin="0,0,6,0"/>
                            </StackPanel>

                            <!-- Right Pill Badges for Container Info -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Title:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                                <TextBox Text="{Binding ContainerTitle, UpdateSourceTrigger=PropertyChanged}" Width="160" Padding="6,3" FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Workspace Area -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320" MinWidth="260" MaxWidth="480"/>
                            <ColumnDefinition Width="4"/> <!-- Splitter -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Panel: Subtitle Tracks & Inspector -->
                        <Grid Grid.Column="0" Background="{StaticResource BgPanel}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="200" MinHeight="120"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Track List Header -->
                            <Border Grid.Row="0" Padding="12,8" Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="SUBTITLE TRACKS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="➕ Add" Command="{Binding AddTrackFromFileCommand}" Padding="6,2" Margin="0,0,4,0" FontSize="11"/>
                                        <Button Content="📋 Copy" Command="{Binding DuplicateTrackCommand}" Padding="6,2" Margin="0,0,4,0" FontSize="11"/>
                                        <Button Content="🗑️ Del" Command="{Binding RemoveTrackCommand}" Padding="6,2" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Track Cards ListBox -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                                     Background="{StaticResource BgPanel}" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,7" CornerRadius="6" Margin="2,2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,0,50,0"/>
                                                    <Border HorizontalAlignment="Right" Background="{StaticResource AccentPrimary}" CornerRadius="4" Padding="5,1">
                                                        <TextBlock Text="{Binding Language, StringFormat='{}{0}'}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Border Background="{StaticResource BgCardElevated}" CornerRadius="3" Padding="4,1" Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding CodecDisplay}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding CueCount, StringFormat='{}{0} cues'}" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBlock Text="[DEFAULT]" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center" Visibility="{Binding IsDefault, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Margin="0,0,4,0"/>
                                                    <TextBlock Text="[FORCED]" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentAmber}" VerticalAlignment="Center" Visibility="{Binding IsForced, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Track Inspector Header -->
                            <Border Grid.Row="2" Padding="12,8" Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,1">
                                <TextBlock Text="TRACK PROPERTIES &amp; CONVERSION" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPrimary}"/>
                            </Border>

                            <!-- Track Inspector Details -->
                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="14,12">
                                <StackPanel DataContext="{Binding SelectedTrack}">
                                    <TextBlock Text="Track Name:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                            <TextBlock Text="Language (ISO-639):" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="Format / Codec:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,3"/>
                                            <Border Background="{StaticResource BgInput}" CornerRadius="5" Padding="6,4" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                                <TextBlock Text="{Binding CodecDisplay}" Foreground="{StaticResource AccentPrimary}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Flags -->
                                    <Border Background="{StaticResource BgCard}" CornerRadius="6" Padding="10,8" Margin="0,0,0,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox Content="Default Track" IsChecked="{Binding IsDefault}" Foreground="{StaticResource TextPrimary}" Margin="0,0,18,0"/>
                                            <CheckBox Content="Forced Track" IsChecked="{Binding IsForced}" Foreground="{StaticResource TextPrimary}"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Conversion Card -->
                                    <Border Background="{StaticResource BgCard}" CornerRadius="6" Padding="10,10" Margin="0,0,0,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="Quick Format Conversion" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0" Content="➔ Convert to SRT" Command="{Binding DataContext.ConvertTrackToSrtCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,4,0" Padding="4,5" FontSize="11"/>
                                                <Button Grid.Column="1" Content="➔ Convert to ASS" Command="{Binding DataContext.ConvertTrackToAssCommand, RelativeSource={RelativeSource AncestorType=Window}}" Margin="4,0,0,0" Padding="4,5" FontSize="11"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Button Content="📤 Export This Track..." Command="{Binding DataContext.ExportTrackCommand, RelativeSource={RelativeSource AncestorType=Window}}" Padding="8,8" Background="{StaticResource BgCardElevated}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Vertical Splitter -->
                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderDark}" Cursor="SizeWE"/>

                        <!-- Center & Right Panel: Subtitle Editor & Live Preview -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Quick Filter & Grid Ribbon -->
                                <RowDefinition Height="*"/>    <!-- Subtitle DataGrid -->
                                <RowDefinition Height="4"/>    <!-- Splitter -->
                                <RowDefinition Height="240" MinHeight="140"/> <!-- Bottom Editor & Preview -->
                            </Grid.RowDefinitions>

                            <!-- Subtitle Grid Toolbar with Search Filter Bar -->
                            <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="12,6">
                                <Grid>
                                    <!-- Left Cue Action Buttons -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Button Content="➕ Add Line" Command="{Binding AddCueCommand}" Background="{StaticResource AccentPrimary}" Foreground="#FFFFFF" Margin="0,0,6,0"/>
                                        <Button Content="🗑️ Delete" Command="{Binding DeleteCueCommand}" Margin="0,0,6,0"/>
                                        <Button Content="✂️ Split" Command="{Binding SplitCueCommand}" Margin="0,0,6,0"/>
                                        <Button Content="▲ Move Up" Command="{Binding MoveCueUpCommand}" Margin="0,0,6,0"/>
                                        <Button Content="▼ Move Down" Command="{Binding MoveCueDownCommand}" Margin="0,0,12,0"/>
                                    </StackPanel>

                                    <!-- Right Live Search Filter Bar -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <TextBlock Text="🔍 Filter:" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Text="{Binding FilterQuery, UpdateSourceTrigger=PropertyChanged}" Width="200" Padding="6,3" ToolTip="Filter subtitle lines in real-time as you type"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Virtualized Subtitle DataGrid -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding VisibleCues}" SelectedItem="{Binding SelectedCue}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                      VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling"
                                      EnableRowVirtualization="True" HeadersVisibility="Column" SelectionMode="Single"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderDark}" BorderThickness="0">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource BgCardElevated}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        <Setter Property="Padding" Value="10,7"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="45" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Start Time" Binding="{Binding StartTimeText, UpdateSourceTrigger=LostFocus}" Width="120" FontFamily="Consolas, Segoe UI"/>
                                    <DataGridTextColumn Header="End Time" Binding="{Binding EndTimeText, UpdateSourceTrigger=LostFocus}" Width="120" FontFamily="Consolas, Segoe UI"/>
                                    <DataGridTextColumn Header="Duration" Binding="{Binding DurationText}" Width="90" IsReadOnly="True" FontFamily="Consolas, Segoe UI"/>
                                    <DataGridTextColumn Header="Style" Binding="{Binding Style}" Width="90"/>
                                    <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="90"/>
                                    <DataGridTextColumn Header="Subtitle Text Content" Binding="{Binding RawText}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Horizontal Splitter -->
                            <GridSplitter Grid.Row="2" Height="4" HorizontalAlignment="Stretch" Background="{StaticResource BorderDark}" Cursor="SizeNS"/>

                            <!-- Bottom Editor & Live Cinema Preview -->
                            <Grid Grid.Row="3" Background="{StaticResource BgPanel}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Multiline Subtitle Text Editor & Formatting Bar -->
                                <Border Grid.Column="0" Padding="14,10" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/> <!-- Format Toolbar -->
                                            <RowDefinition Height="*"/>    <!-- Text Area -->
                                            <RowDefinition Height="Auto"/> <!-- Char Count Stats -->
                                        </Grid.RowDefinitions>

                                        <!-- Text Formatting Buttons -->
                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="EDIT TEXT:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <Button Content="𝗕 Bold" Command="{Binding InsertFormattingCommand}" CommandParameter="b" Padding="6,2" Margin="0,0,4,0" FontSize="11"/>
                                                <Button Content="𝘐 Italic" Command="{Binding InsertFormattingCommand}" CommandParameter="i" Padding="6,2" Margin="0,0,4,0" FontSize="11"/>
                                                <Button Content="U Underline" Command="{Binding InsertFormattingCommand}" CommandParameter="u" Padding="6,2" Margin="0,0,4,0" FontSize="11"/>
                                                <Button Content="↵ \N Newline" Command="{Binding InsertFormattingCommand}" CommandParameter="n" Padding="6,2" Margin="0,0,4,0" FontSize="11"/>
                                                <Button Content="🎨 Yellow" Command="{Binding InsertFormattingCommand}" CommandParameter="color_yellow" Padding="6,2" Margin="0,0,4,0" FontSize="11"/>
                                                <Button Content="🎨 Cyan" Command="{Binding InsertFormattingCommand}" CommandParameter="color_cyan" Padding="6,2" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Big Text Box -->
                                        <TextBox Grid.Row="1" Text="{Binding SelectedCue.RawText, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 Background="{StaticResource BgDark}" Foreground="#FFFFFF" FontSize="15" Padding="10" BorderBrush="{StaticResource BorderDark}"/>

                                        <!-- Character Stats -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding SelectedCueCharCount, StringFormat='{}Characters: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding SelectedCueWordCount, StringFormat='{}Words: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,12,0"/>
                                            <TextBlock Text="{Binding SelectedCueLineCount, StringFormat='{}Lines: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Right: Cinema Style Visual Preview Screen -->
                                <Border Grid.Column="1" Padding="14,10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0" Margin="0,0,0,6">
                                            <TextBlock Text="LIVE CINEMA PREVIEW" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPrimary}"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding SelectedCue.Style, StringFormat='{}Style: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding SelectedCue.Actor, StringFormat='{}Actor: {0}'}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Simulated Cinema Canvas Viewport -->
                                        <Border Grid.Row="1" Background="#000000" CornerRadius="8" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">
                                            <Grid>
                                                <!-- Timecode HUD overlay on top-left -->
                                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" Background="#33000000" CornerRadius="4" Padding="6,2">
                                                    <TextBlock Text="{Binding SelectedCue.StartTimeText, StringFormat='{}▶ {0}'}" Foreground="#00E5FF" FontSize="10" FontFamily="Consolas, Segoe UI"/>
                                                </Border>

                                                <!-- Watermark in center -->
                                                <TextBlock Text="16:9 PREVIEW VIEWPORT" Foreground="#1E1E1E" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold"/>

                                                <!-- Rendered Subtitle Text -->
                                                <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,20" Padding="12,6">
                                                    <TextBlock Text="{Binding PreviewText}" Foreground="#FFFFFF" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" FontFamily="Arial, Segoe UI">
                                                        <TextBlock.Effect>
                                                            <DropShadowEffect Color="Black" BlurRadius="8" ShadowDepth="2" Opacity="0.95"/>
                                                        </TextBlock.Effect>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 2: MKV SUBTITLE EXTRACTOR VIEW         -->
            <!-- ========================================== -->
            <TabItem DataContext="{Binding ExtractorVm}">
                <Grid Margin="30,20,30,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Input Selection -->
                        <RowDefinition Height="*"/>    <!-- Track List -->
                        <RowDefinition Height="Auto"/> <!-- Output Options -->
                        <RowDefinition Height="Auto"/> <!-- Progress & Logs -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="🎬 MKV Subtitle Extractor &amp; Demuxer" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentPurple}"/>
                            <TextBlock Text="Ekstrak subtitle (SRT, ASS, VTT, PGS) dan font langsung dari file video MKV menggunakan MKVToolNix Engine." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Input File / Folder Selection Dropzone -->
                    <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="8" Padding="15,12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Source MKV:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,12,0"/>
                                <TextBox Grid.Column="1" Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource BgInput}" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderDark}" Padding="8,5"/>
                                <Button Grid.Column="2" Content="📁 Browse..." Command="{Binding BrowseInputCommand}" Background="{StaticResource AccentPrimary}" Foreground="#FFFFFF" Margin="8,0,0,0" Padding="14,5"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal">
                                <CheckBox Content="Batch Folder Mode (Proses semua MKV dalam folder sekaligus)" IsChecked="{Binding IsBatchMode}" Foreground="{StaticResource TextPrimary}" Margin="0,0,20,0"/>
                                <TextBlock Text="💡 Tip: Anda dapat Drag &amp; Drop file .mkv atau folder langsung ke layar ini." Foreground="{StaticResource TextMuted}" FontStyle="Italic"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Subtitle Tracks & Attachments DataGrid -->
                    <Grid Grid.Row="2" Margin="0,0,0,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Table Header Toolbar -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <TextBlock Text="DETECTED SUBTITLE TRACKS &amp; FONTS:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="✓ Select All" Command="{Binding SelectAllTracksCommand}" Padding="8,3" Margin="0,0,6,0" FontSize="11"/>
                                <Button Content="✗ Deselect All" Command="{Binding DeselectAllTracksCommand}" Padding="8,3" FontSize="11"/>
                            </StackPanel>
                        </Grid>

                        <!-- DataGrid -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ScannedTracks}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  Background="{StaticResource BgPanel}" Foreground="{StaticResource TextPrimary}" RowBackground="{StaticResource BgDark}" AlternatingRowBackground="{StaticResource BgPanel}"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderDark}" BorderBrush="{StaticResource BorderDark}" HeadersVisibility="Column">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource BgCardElevated}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="Padding" Value="10,7"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Header="Extract" Binding="{Binding IsSelected}" Width="65"/>
                                <DataGridTextColumn Header="Track ID" Binding="{Binding Id}" Width="75" IsReadOnly="True" FontFamily="Consolas"/>
                                <DataGridTextColumn Header="Codec Format" Binding="{Binding Codec}" Width="160" IsReadOnly="True" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Language" Binding="{Binding Language}" Width="85" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Default" Binding="{Binding IsDefault}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Forced" Binding="{Binding IsForced}" Width="70" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Track Name" Binding="{Binding TrackName}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Output Options Card -->
                    <Border Grid.Row="3" Background="{StaticResource BgCard}" CornerRadius="8" Padding="15,12" Margin="0,0,0,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="EXTRACTION TARGET &amp; FORMAT:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPrimary}" Margin="0,0,0,8"/>

                            <!-- Output Format Radios -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <RadioButton Grid.Column="0" Content="Standalone Subtitle (.srt / .ass / .sup)" IsChecked="{Binding OutputMode, Converter={StaticResource TimeSpanToStringConverter}, FallbackValue=True}" GroupName="OutputMode" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,24,0" Checked="OnModeStandaloneChecked"/>
                                <RadioButton Grid.Column="1" Content="Pure .mks Subtitle Container" GroupName="OutputMode" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Margin="0,0,24,0" Checked="OnModeMksChecked"/>
                                <RadioButton Grid.Column="2" Content="Embedded Fonts Only" GroupName="OutputMode" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" Checked="OnModeFontsChecked"/>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <CheckBox Content="Ekstrak file font embedded (TTF/OTF) ke folder ./fonts/" IsChecked="{Binding ExtractFonts}" Foreground="{StaticResource TextSecondary}"/>
                            </StackPanel>

                            <!-- Output Folder -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Output Folder:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,12,0"/>
                                <TextBox Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" Background="{StaticResource BgInput}" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderDark}" Padding="8,5"/>
                                <Button Grid.Column="2" Content="📁 Select Folder..." Command="{Binding BrowseOutputFolderCommand}" Margin="8,0,0,0" Padding="12,5"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Progress & Status -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,12">
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ProgressValue, StringFormat='{}{0}%'}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontWeight="Bold"/>
                        </Grid>
                        <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="8" Background="{StaticResource BgPanel}" Foreground="{StaticResource AccentPurple}" BorderThickness="0"/>
                    </StackPanel>

                    <!-- Bottom Action Buttons -->
                    <Grid Grid.Row="5">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="✏️ Open in MKS Studio Editor" Command="{Binding OpenLastInEditorCommand}" Background="{StaticResource AccentGreen}" Foreground="#FFFFFF" FontWeight="Bold" Padding="14,8" BorderThickness="0" Margin="0,0,8,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="⚡ Start Extraction" Command="{Binding ExtractCommand}" Background="{StaticResource AccentPurple}" Foreground="#FFFFFF" FontWeight="Bold" Padding="20,8" BorderThickness="0" IsDefault="True"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom Status Bar -->
        <StatusBar Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Foreground="{StaticResource TextSecondary}" Padding="12,4">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="MKS Subtitle Studio v1.0 | .NET 10 WPF" Foreground="{StaticResource TextMuted}" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>

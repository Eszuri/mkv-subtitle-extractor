<ui:FluentWindow x:Class="MksStudio.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MksStudio.UI.ViewModels"
        xmlns:controls="clr-namespace:MksStudio.UI.Controls"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="920" Width="1540" MinHeight="780" MinWidth="1280"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnWindowDrop"
        Icon="app.ico"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Foreground="{StaticResource TextPrimary}" FontFamily="Segoe UI Variable, Segoe UI">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Modern TitleBar & Navigation -->
            <RowDefinition Height="*"/>    <!-- Main Views (Home, Editor, Extractor) -->
            <RowDefinition Height="Auto"/> <!-- Bottom Status Bar -->
        </Grid.RowDefinitions>

        <!-- 1. Modern Windows 11 TitleBar & Navigation Header -->
        <ui:TitleBar x:Name="AppTitleBar"
                     Grid.Row="0"
                     Height="52"
                     Padding="0"
                     HorizontalContentAlignment="Stretch"
                     VerticalAlignment="Stretch">
            <!-- Left: Branding (Clean 20px left margin, vertically centered, no clipping) -->
            <ui:TitleBar.Header>
                <Grid Width="260" Margin="20,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                        <Border Width="32" Height="32" Background="{StaticResource AccentIndigo}" CornerRadius="9" Margin="0,0,10,0" VerticalAlignment="Center">
                            <ui:SymbolIcon Symbol="Video24" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="MKS STUDIO" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,2"/>
                            <TextBlock Text="Matroska Subtitle Toolkit" FontSize="10" Foreground="{StaticResource TextSecondary}" Margin="0"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </ui:TitleBar.Header>

            <!-- Center: Nav Pills (Strictly Centered horizontally across window) -->
            <ui:TitleBar.CenterContent>
                <Border x:Name="NavPillBorder"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Height="40"
                        Background="{StaticResource BgPanel}"
                        CornerRadius="20"
                        Padding="4,3"
                        BorderBrush="{StaticResource BorderDark}"
                        BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Home Tab -->
                        <Button x:Name="BtnNavHome"
                                Command="{Binding NavigateToHomeCommand}"
                                Click="OnNavHomeClicked"
                                PreviewMouseLeftButtonDown="OnNavHomePreviewMouseDown"
                                Cursor="Hand"
                                Padding="16,0"
                                Height="32"
                                Margin="0,0,3,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="Home24" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Home" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="16"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BgHover}"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewIndex}" Value="0">
                                            <Setter Property="Background" Value="{StaticResource BgCardElevated}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- MKS Editor Tab -->
                        <Button x:Name="BtnNavEditor"
                                Command="{Binding NavigateToEditorCommand}"
                                Click="OnNavEditorClicked"
                                PreviewMouseLeftButtonDown="OnNavEditorPreviewMouseDown"
                                Cursor="Hand"
                                Padding="16,0"
                                Height="32"
                                Margin="0,0,3,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="MKS Subtitle Editor" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="16"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BgHover}"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewIndex}" Value="1">
                                            <Setter Property="Background" Value="{StaticResource BgCardElevated}"/>
                                            <Setter Property="Foreground" Value="{StaticResource AccentPrimary}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- MKV Extractor Tab -->
                        <Button x:Name="BtnNavExtractor"
                                Command="{Binding NavigateToExtractorCommand}"
                                Click="OnNavExtractorClicked"
                                PreviewMouseLeftButtonDown="OnNavExtractorPreviewMouseDown"
                                Cursor="Hand"
                                Padding="16,0"
                                Height="32">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="VideoClip24" FontSize="15" Margin="0,0,7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="MKV Subtitle Extractor" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="btnBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="16"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="btnBorder" Property="Background" Value="{StaticResource BgHover}"/>
                                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentViewIndex}" Value="2">
                                            <Setter Property="Background" Value="{StaticResource AccentPurple}"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </ui:TitleBar.CenterContent>

            <!-- Right: Duration Stats Pill (Centered vertically, 30px height, 22px margin from caption buttons) -->
            <ui:TitleBar.TrailingContent>
                <Border x:Name="DurationBorder"
                        Background="{StaticResource BgPanel}"
                        CornerRadius="15"
                        Height="30"
                        Padding="12,0"
                        VerticalAlignment="Center"
                        BorderBrush="{StaticResource BorderDark}"
                        BorderThickness="1"
                        Margin="0,0,22,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="Clock24" FontSize="13" Foreground="{StaticResource AccentPrimary}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TotalDurationText}" Foreground="{StaticResource AccentPrimary}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- 2. Main View Switcher (TabControl with Hidden Headers) -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding CurrentViewIndex}" Background="Transparent" BorderThickness="0">
            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </Style>
            </TabControl.ItemContainerStyle>

            <!-- ========================================== -->
            <!-- TAB 0: HOME DASHBOARD (FLUENT HUB)         -->
            <!-- ========================================== -->
            <TabItem>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="40,26,40,26" MaxWidth="1360" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- 2 Major Action Cards -->
                            <RowDefinition Height="Auto"/> <!-- Drag & Drop Zone -->
                        </Grid.RowDefinitions>

                        <!-- 2 Major Action Cards -->
                        <Grid Grid.Row="0" Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CARD 1: MKV EXTRACTOR -->
                            <ui:Card Grid.Column="0" Padding="26,24" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Card Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="46" Height="46" Background="#2E1065" CornerRadius="12" Margin="0,0,14,0">
                                                <ui:SymbolIcon Symbol="VideoClip24" FontSize="24" Foreground="{StaticResource AccentPurple}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="MKV Subtitle Extractor" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Demuxer &amp; Font Extractor" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="#1E1B4B" CornerRadius="6" Padding="7,3" VerticalAlignment="Top">
                                            <TextBlock Text="MKVToolNix Engine" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentPurple}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Card Description -->
                                    <TextBlock Grid.Row="1" Text="Ekstrak subtitle (SRT, ASS, VTT, PGS) dan seluruh font embedded (TTF/OTF) langsung dari video MKV, baik file tunggal maupun seluruh folder secara batch."
                                               Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18" LineHeight="18"/>

                                    <!-- Feature Badges -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,22">
                                        <Border Background="{StaticResource BgPanel}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="✓ Batch Folder" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        </Border>
                                        <Border Background="{StaticResource BgPanel}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="✓ Subtitle .srt/.ass" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        </Border>
                                        <Border Background="{StaticResource BgPanel}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="✓ Font TTF/OTF" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Card Action Buttons -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:Button Grid.Column="0" Content="Pilih File .mkv..." Command="{Binding ExtractorVm.BrowseInputCommand}"
                                                   Appearance="Primary" HorizontalAlignment="Stretch" Padding="0,11" FontWeight="SemiBold"
                                                   Icon="{ui:SymbolIcon Symbol=FolderOpen24}"/>

                                        <ui:Button Grid.Column="2" Content="Buka Extractor" Command="{Binding NavigateToExtractorCommand}"
                                                   Appearance="Secondary" HorizontalAlignment="Stretch" Padding="0,11" FontWeight="SemiBold"
                                                   Icon="{ui:SymbolIcon Symbol=ArrowRight24}"/>
                                    </Grid>
                                </Grid>
                            </ui:Card>

                            <!-- CARD 2: MKS SUBTITLE STUDIO -->
                            <ui:Card Grid.Column="2" Padding="26,24" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Card Header -->
                                    <Grid Grid.Row="0" Margin="0,0,0,14">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="46" Height="46" Background="#082F49" CornerRadius="12" Margin="0,0,14,0">
                                                <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="24" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="MKS Subtitle Studio" FontSize="17" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                <TextBlock Text="Editor, Converter &amp; Translator" FontSize="12" Foreground="{StaticResource TextMuted}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border HorizontalAlignment="Right" Background="#0C4A6E" CornerRadius="6" Padding="7,3" VerticalAlignment="Top">
                                            <TextBlock Text="Pure C# EBML" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}"/>
                                        </Border>
                                    </Grid>

                                    <!-- Card Description -->
                                    <TextBlock Grid.Row="1" Text="Buka, edit ribuan baris subtitle dengan virtualized DataGrid, konversi lintas format (SRT, ASS, VTT, TTML, SAMI, MicroDVD, SBV, LRC), terjemahkan online dengan Google Translate, dan simpan ke .mks native."
                                               Foreground="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,18" LineHeight="18"/>

                                    <!-- Feature Badges -->
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,22">
                                        <Border Background="{StaticResource BgPanel}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="✓ 10+ Format Subtitle" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentPrimary}"/>
                                        </Border>
                                        <Border Background="{StaticResource BgPanel}" CornerRadius="4" Padding="6,2" Margin="0,0,6,0">
                                            <TextBlock Text="✓ Google Translate" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        </Border>
                                        <Border Background="{StaticResource BgPanel}" CornerRadius="4" Padding="6,2">
                                            <TextBlock Text="✓ Multi-Track .mks" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        </Border>
                                    </StackPanel>

                                    <!-- Card Action Buttons -->
                                    <Grid Grid.Row="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <ui:Button Grid.Column="0" Content="Buka File Subtitle..." Command="{Binding OpenFileCommand}"
                                                   Appearance="Primary" HorizontalAlignment="Stretch" Padding="0,11" FontWeight="SemiBold"
                                                   Icon="{ui:SymbolIcon Symbol=FolderOpen24}"/>

                                        <ui:Button Grid.Column="2" Content="Buat Baru" Command="{Binding CreateNewFileCommand}"
                                                   Appearance="Secondary" HorizontalAlignment="Stretch" Padding="0,11" FontWeight="SemiBold"
                                                   Icon="{ui:SymbolIcon Symbol=Add24}"/>
                                    </Grid>
                                </Grid>
                            </ui:Card>
                        </Grid>

                        <!-- Drag & Drop Zone -->
                        <Border Grid.Row="1" CornerRadius="14" Padding="28,20" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1.5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="46" Height="46" Background="{StaticResource BgCard}" CornerRadius="12" Margin="0,0,18,0">
                                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="24" Foreground="{StaticResource AccentPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="Drag &amp; Drop file .mkv, .mks, .srt, .ass, .vtt, .ttml, .smi, .sub, .sbv, atau .lrc ke sini" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}"/>
                                    <TextBlock Text="Aplikasi akan mendeteksi format subtitle secara otomatis dan mengarahkan ke editor atau extractor." FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 1: MKS SUBTITLE STUDIO (EDITOR/VIEWER) -->
            <!-- ========================================== -->
            <TabItem>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Fluent Action Toolbar -->
                        <RowDefinition Height="*"/>    <!-- Workspace Area -->
                    </Grid.RowDefinitions>

                    <!-- Fluent Action Toolbar -->
                    <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Toolbar Action Buttons -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ui:Button Content="Tambah Track" Command="{Binding AddTrackFromFileCommand}" Icon="{ui:SymbolIcon Symbol=Add24}" Margin="0,0,10,0" ToolTip="Impor file subtitle sebagai track baru"/>

                                <Border Width="1" Background="{StaticResource BorderDark}" Margin="4,4,10,4"/>

                                <ui:Button Content="Cari &amp; Ganti" Click="OnOpenSearchReplaceClicked" Icon="{ui:SymbolIcon Symbol=Search24}" Margin="0,0,5,0" ToolTip="Cari dan ganti teks (Regex)"/>
                                <ui:Button Content="Font" Click="OnOpenAttachmentsClicked" Icon="{ui:SymbolIcon Symbol=FontIncrease24}" Margin="0,0,5,0" ToolTip="Kelola embedded font TTF/OTF"/>
                                <ui:Button Content="Terjemahkan" Click="OnOpenTranslationClicked" Icon="{ui:SymbolIcon Symbol=LocalLanguage24}" Margin="0,0,10,0" ToolTip="Terjemahkan subtitle dengan Google Translate online"/>

                                <Border Width="1" Background="{StaticResource BorderDark}" Margin="4,4,10,4"/>

                                <ui:Button Content="Simpan .mks" Command="{Binding SaveFileCommand}" Icon="{ui:SymbolIcon Symbol=Save24}" Margin="0,0,5,0" ToolTip="Simpan langsung ke container .mks (Ctrl+S)"/>
                                <ui:Button Content="Ekspor" Command="{Binding ExportTrackCommand}" Icon="{ui:SymbolIcon Symbol=Share24}" Margin="0,0,5,0" ToolTip="Ekspor track aktif ke format .srt/.ass"/>
                                <ui:Button Content="Ekspor Semua" Command="{Binding ExportAllTracksCommand}" Icon="{ui:SymbolIcon Symbol=FolderZip24}" Margin="0,0,5,0" ToolTip="Ekspor semua track ke folder"/>
                            </StackPanel>

                            <!-- Container Title Box -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Judul Kontainer:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="11"/>
                                <ui:TextBox Text="{Binding ContainerTitle, UpdateSourceTrigger=PropertyChanged}" Width="190" Height="32" FontSize="11" Padding="8,4"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Workspace Area -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330" MinWidth="280" MaxWidth="500"/>
                            <ColumnDefinition Width="5"/> <!-- Splitter -->
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Panel: Subtitle Tracks & Inspector -->
                        <Grid Grid.Column="0" Background="{StaticResource BgPanel}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Track List Header -->
                            <Border Grid.Row="0" Padding="14,10" Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock Text="TRACK SUBTITLE" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Command="{Binding AddTrackFromFileCommand}" Padding="6,3" Margin="0,0,4,0" ToolTip="Tambah Track">
                                            <ui:SymbolIcon Symbol="Add20" FontSize="12"/>
                                        </Button>
                                        <Button Command="{Binding DuplicateTrackCommand}" Padding="6,3" Margin="0,0,4,0" ToolTip="Duplikasi Track">
                                            <ui:SymbolIcon Symbol="Copy20" FontSize="12"/>
                                        </Button>
                                        <Button Command="{Binding RemoveTrackCommand}" Padding="6,3" ToolTip="Hapus Track">
                                            <ui:SymbolIcon Symbol="Delete20" FontSize="12"/>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Track Cards ListBox -->
                            <ListBox Grid.Row="1" ItemsSource="{Binding Tracks}" SelectedItem="{Binding SelectedTrack}"
                                     Background="{StaticResource BgPanel}" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10,8" CornerRadius="8" Margin="4,3" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Margin="0,0,50,0"/>
                                                    <Border HorizontalAlignment="Right" Background="{StaticResource AccentIndigo}" CornerRadius="4" Padding="6,2">
                                                        <TextBlock Text="{Binding Language, StringFormat='{}{0}'}" FontSize="10" FontWeight="Bold" Foreground="#FFFFFF"/>
                                                    </Border>
                                                </Grid>
                                                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                                    <Border Background="{StaticResource BgCardElevated}" CornerRadius="3" Padding="5,2" Margin="0,0,8,0">
                                                        <TextBlock Text="{Binding CodecDisplay}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding CueCount, StringFormat='{}{0} cues'}" FontSize="10" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Track Inspector Header -->
                            <Border Grid.Row="2" Padding="14,10" Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,1">
                                <TextBlock Text="PROPERTI TRACK" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPrimary}"/>
                            </Border>

                            <!-- Track Inspector Details -->
                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="14,12">
                                <StackPanel DataContext="{Binding SelectedTrack}">
                                    <TextBlock Text="Nama Track:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                    <ui:TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Height="32" Margin="0,0,0,10" FontSize="11" Padding="8,4"/>

                                    <Grid Margin="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                            <TextBlock Text="Bahasa (ISO):" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                            <ui:TextBox Text="{Binding Language, UpdateSourceTrigger=PropertyChanged}" Height="32" FontSize="11" Padding="8,4"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                            <TextBlock Text="Format Codec:" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,4"/>
                                            <Border Background="{StaticResource BgInput}" CornerRadius="5" Padding="8,4" Height="32" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                                <TextBlock Text="{Binding CodecDisplay}" Foreground="{StaticResource AccentPrimary}" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <!-- Vertical Splitter -->
                        <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderDark}" Cursor="SizeWE"/>

                        <!-- Center & Right Panel: Subtitle Editor & Live Preview -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/> <!-- Quick Filter & Grid Ribbon -->
                                <RowDefinition Height="3*" MinHeight="160"/>    <!-- Subtitle DataGrid -->
                                <RowDefinition Height="5"/>    <!-- Splitter -->
                                <RowDefinition Height="2*" MinHeight="170"/> <!-- Bottom Editor & Preview -->
                            </Grid.RowDefinitions>

                            <!-- Subtitle Grid Toolbar with Search Filter Bar -->
                            <Border Grid.Row="0" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,0,1" Padding="14,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Search / Filter Box -->
                                    <ui:TextBox Grid.Column="0" PlaceholderText="Cari teks subtitle..."
                                                Text="{Binding FilterQuery, UpdateSourceTrigger=PropertyChanged}"
                                                Icon="{ui:SymbolIcon Symbol=Search24}" Height="32" FontSize="12" Padding="8,2"/>

                                    <!-- Mid Info -->
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedTrack.Cues.Count, StringFormat='{}Total: {0} baris'}"
                                               Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="11"/>

                                    <!-- Cue Operations -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <ui:Button Content="Tambah" Command="{Binding AddCueCommand}" Icon="{ui:SymbolIcon Symbol=Add24}" Padding="9,5" Margin="0,0,4,0" FontSize="11"/>
                                        <ui:Button Content="Hapus" Command="{Binding DeleteCueCommand}" Icon="{ui:SymbolIcon Symbol=Delete24}" Padding="9,5" Margin="0,0,4,0" FontSize="11"/>
                                        <ui:Button Content="Pecah" Command="{Binding SplitCueCommand}" Icon="{ui:SymbolIcon Symbol=Cut24}" Padding="9,5" Margin="0,0,4,0" FontSize="11"/>
                                        <ui:Button Content="▲" Command="{Binding MoveCueUpCommand}" Padding="7,5" Margin="0,0,3,0" FontSize="11"/>
                                        <ui:Button Content="▼" Command="{Binding MoveCueDownCommand}" Padding="7,5" FontSize="11"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Subtitle DataGrid with Virtualization -->
                            <DataGrid x:Name="CuesDataGrid" Grid.Row="1" ItemsSource="{Binding VisibleCues}" SelectedItem="{Binding SelectedCue}"
                                      AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionMode="Extended"
                                      Background="{StaticResource BgDark}" Foreground="#FFFFFF" RowBackground="{StaticResource BgDark}" AlternatingRowBackground="{StaticResource BgPanel}"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderDark}" BorderBrush="{StaticResource BorderDark}"
                                      EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      HeadersVisibility="Column" RowHeight="30" FontSize="12">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="Background" Value="{StaticResource BgCardElevated}"/>
                                        <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                        <Setter Property="Padding" Value="12,7"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
                                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    </Style>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1E3A8A"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{StaticResource BgHover}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Padding" Value="10,4"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="DataGridCell">
                                                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#1E3A8A"/>
                                                <Setter Property="Foreground" Value="#FFFFFF"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="50" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Mulai" Binding="{Binding StartTimeText}" Width="115" FontFamily="Consolas"/>
                                    <DataGridTextColumn Header="Selesai" Binding="{Binding EndTimeText}" Width="115" FontFamily="Consolas"/>
                                    <DataGridTextColumn Header="Durasi" Binding="{Binding DurationText}" Width="115" IsReadOnly="True" FontFamily="Consolas"/>
                                    <DataGridTextColumn Header="Style" Binding="{Binding Style}" Width="110"/>
                                    <DataGridTextColumn Header="Karakter" Binding="{Binding Actor}" Width="110"/>
                                    <DataGridTextColumn Header="Teks Subtitle" Binding="{Binding RawText}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Horizontal Splitter -->
                            <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderDark}" Cursor="SizeNS"/>

                            <!-- Bottom Cue Inspector & Cinema Preview -->
                            <Grid Grid.Row="3" Background="{StaticResource BgPanel}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="480" MinWidth="360" MaxWidth="640"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Cue Text Editor & Quick Format Bar -->
                                <Border Grid.Column="0" Padding="16,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,0,1,0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Comprehensive Subtitle Formatting Preset Toolbar -->
                                        <Border Grid.Row="0" Margin="0,0,0,10" Background="#161922" BorderBrush="{StaticResource BorderDark}" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="PRESET FORMAT:" FontWeight="Bold" FontSize="10" Foreground="{StaticResource AccentPrimary}" VerticalAlignment="Center" Margin="2,0,8,0"/>

                                                <!-- Style Group (Bold, Italic, Underline, Strikeout) -->
                                                <Border Background="#0F131B" CornerRadius="4" Padding="2" Margin="0,0,6,0" BorderBrush="#252C3A" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="𝗕" Width="26" Height="24" Padding="0" Focusable="False" Tag="b" Click="OnFormatActionClicked"
                                                                ToolTip="Bold / Tebal (Ctrl+B) - {\b1}..{\b0}" Background="Transparent" BorderThickness="0" Foreground="#F1F5F9" FontWeight="Bold" FontSize="12"/>
                                                        <Button Content="𝘐" Width="26" Height="24" Padding="0" Focusable="False" Tag="i" Click="OnFormatActionClicked"
                                                                ToolTip="Italic / Miring (Ctrl+I) - {\i1}..{\i0}" Background="Transparent" BorderThickness="0" Foreground="#F1F5F9" FontStyle="Italic" FontSize="12"/>
                                                        <Button Content="U̲" Width="26" Height="24" Padding="0" Focusable="False" Tag="u" Click="OnFormatActionClicked"
                                                                ToolTip="Underline / Garis Bawah (Ctrl+U) - {\u1}..{\u0}" Background="Transparent" BorderThickness="0" Foreground="#F1F5F9" FontSize="12"/>
                                                        <Button Content="S̶" Width="26" Height="24" Padding="0" Focusable="False" Tag="s" Click="OnFormatActionClicked"
                                                                ToolTip="Strikeout / Coret Teks - {\s1}..{\s0}" Background="Transparent" BorderThickness="0" Foreground="#F1F5F9" FontSize="12"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Linebreak & Spacing Group -->
                                                <Border Background="#0F131B" CornerRadius="4" Padding="2" Margin="0,0,6,0" BorderBrush="#252C3A" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Content="↵ \N" Height="24" Padding="6,0" Focusable="False" Tag="n" Click="OnFormatActionClicked"
                                                                ToolTip="Ganti Baris Subtitle ASS (Shift+Enter) - \N" Background="Transparent" BorderThickness="0" Foreground="#38BDF8" FontWeight="SemiBold" FontSize="11"/>
                                                        <Button Content="⎵ \h" Height="24" Padding="6,0" Focusable="False" Tag="h" Click="OnFormatActionClicked"
                                                                ToolTip="Spasi Keras Subtitle ASS (Hard Space) - \h" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" FontSize="11"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Color Custom Button (Single Unified Picker) -->
                                                <Button Content="🎨 Kustom" Height="24" Padding="8,0" Margin="0,0,6,0" Focusable="False" Click="OnOpenCustomColorPickerClicked"
                                                        ToolTip="Pilih Warna Subtitle Kustom (Palet 32 Warna, RGB Slider, &amp; Hex Code)"
                                                        Background="#0F131B" BorderBrush="#252C3A" BorderThickness="1" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold"/>

                                                <!-- Screen Alignment Group -->
                                                <Button Content="⤧ Posisi ▼" Height="24" Padding="6,0" Margin="0,0,6,0" Focusable="False" Click="OnOpenAlignMenuClicked"
                                                        ToolTip="Atur Posisi Subtitle di Layar ({\an1} - {\an9})" Background="#0F131B" BorderBrush="#252C3A" BorderThickness="1" Foreground="#CBD5E1" FontSize="11">
                                                    <Button.ContextMenu>
                                                        <ContextMenu Background="#1A1F2C" Foreground="#E2E8F0" BorderBrush="#2A3241">
                                                            <MenuItem Header="Top-Center (Tengah Atas) - \an8" Click="OnAlignMenuItemClicked" Tag="8"/>
                                                            <MenuItem Header="Top-Left (Kiri Atas) - \an7" Click="OnAlignMenuItemClicked" Tag="7"/>
                                                            <MenuItem Header="Top-Right (Kanan Atas) - \an9" Click="OnAlignMenuItemClicked" Tag="9"/>
                                                            <Separator Background="#2A3241"/>
                                                            <MenuItem Header="Mid-Center (Tengah Layar) - \an5" Click="OnAlignMenuItemClicked" Tag="5"/>
                                                            <MenuItem Header="Mid-Left (Tengah Kiri) - \an4" Click="OnAlignMenuItemClicked" Tag="4"/>
                                                            <MenuItem Header="Mid-Right (Tengah Kanan) - \an6" Click="OnAlignMenuItemClicked" Tag="6"/>
                                                            <Separator Background="#2A3241"/>
                                                            <MenuItem Header="Bottom-Center (Default Bawah) - \an2" Click="OnAlignMenuItemClicked" Tag="2"/>
                                                            <MenuItem Header="Bottom-Left (Kiri Bawah) - \an1" Click="OnAlignMenuItemClicked" Tag="1"/>
                                                            <MenuItem Header="Bottom-Right (Kanan Bawah) - \an3" Click="OnAlignMenuItemClicked" Tag="3"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>

                                                <!-- Case Transformation Group -->
                                                <Button Content="Aa Huruf ▼" Height="24" Padding="6,0" Margin="0,0,6,0" Focusable="False" Click="OnOpenCaseMenuClicked"
                                                        ToolTip="Ubah Kapitalisasi Huruf" Background="#0F131B" BorderBrush="#252C3A" BorderThickness="1" Foreground="#CBD5E1" FontSize="11">
                                                    <Button.ContextMenu>
                                                        <ContextMenu Background="#1A1F2C" Foreground="#E2E8F0" BorderBrush="#2A3241">
                                                            <MenuItem Header="HURUF BESAR (UPPERCASE)" Click="OnCaseMenuItemClicked" Tag="upper"/>
                                                            <MenuItem Header="huruf kecil (lowercase)" Click="OnCaseMenuItemClicked" Tag="lower"/>
                                                            <MenuItem Header="Huruf Besar Tiap Kata (Title Case)" Click="OnCaseMenuItemClicked" Tag="title"/>
                                                            <MenuItem Header="Huruf besar awal kalimat (Sentence case)" Click="OnCaseMenuItemClicked" Tag="sentence"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>

                                                <!-- Clean Strip Group -->
                                                <Button Content="🧹 Bersihkan" Height="24" Padding="6,0" Focusable="False" Tag="strip" Click="OnFormatActionClicked"
                                                        ToolTip="Hapus semua tag format ASS {\...} atau HTML dari teks terpilih / baris ini"
                                                        Background="#1A1418" BorderBrush="#4B2328" BorderThickness="1" Foreground="#F87171" FontSize="11"/>
                                            </WrapPanel>
                                        </Border>

                                        <!-- Text Box -->
                                        <TextBox x:Name="CueRawTextBox" Grid.Row="1" Text="{Binding SelectedCue.RawText, UpdateSourceTrigger=PropertyChanged}"
                                                 IsInactiveSelectionHighlightEnabled="True"
                                                 PreviewKeyDown="OnCueRawTextBoxPreviewKeyDown"
                                                 TextChanged="OnCueRawTextBoxTextChanged"
                                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                                 Background="{StaticResource BgDark}" Foreground="#FFFFFF" FontSize="15" Padding="12,10" BorderBrush="{StaticResource BorderDark}"/>

                                        <!-- Character Stats -->
                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
                                            <TextBlock Text="{Binding SelectedCueCharCount, StringFormat='{}Karakter: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,16,0"/>
                                            <TextBlock Text="{Binding SelectedCueWordCount, StringFormat='{}Kata: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}" Margin="0,0,16,0"/>
                                            <TextBlock Text="{Binding SelectedCueLineCount, StringFormat='{}Baris: {0}'}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Right: Cinema Style Visual Preview Screen -->
                                <Border Grid.Column="1" Padding="16,12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Header Bar -->
                                        <Grid Grid.Row="0" Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="LIVE CINEMA PREVIEW" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPrimary}"/>
                                                <Border Margin="8,0,0,0" Background="#1800E5FF" CornerRadius="3" Padding="5,1">
                                                    <TextBlock Text="16:9 VIEWPORT" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentPrimary}"/>
                                                </Border>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <!-- Style Pill with Live Color Chip -->
                                                <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="0,0,8,0"
                                                        Visibility="{Binding HasSelectedCue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding PreviewPrimaryBrush}" Stroke="#40FFFFFF" StrokeThickness="1" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding ActiveStyleDisplayName, StringFormat='{}Style: {0}'}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding SelectedCueActorText}" FontSize="11" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"
                                                           Visibility="{Binding HasSelectedCueActor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Simulated Cinema Canvas Viewport -->
                                        <Border Grid.Row="1" CornerRadius="8" BorderBrush="{StaticResource BorderLight}" BorderThickness="1" ClipToBounds="True">
                                            <!-- Realistic dark cinema screen backdrop with subtle vignette -->
                                            <Border.Background>
                                                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.85" RadiusY="0.85">
                                                    <GradientStop Color="#0E141D" Offset="0.0"/>
                                                    <GradientStop Color="#080B10" Offset="0.65"/>
                                                    <GradientStop Color="#020305" Offset="1.0"/>
                                                </RadialGradientBrush>
                                            </Border.Background>

                                            <Grid>
                                                <!-- Subtle 16:9 Safe Title / Safe Action Guide Lines -->
                                                <Border Margin="18,14" BorderBrush="#0DFFFFFF" BorderThickness="1" SnapsToDevicePixels="True" IsHitTestVisible="False">
                                                    <Grid>
                                                        <!-- Corner framing ticks -->
                                                        <Path Data="M 0,8 L 0,0 L 8,0" Stroke="#25FFFFFF" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top"/>
                                                        <Path Data="M 0,0 L 8,0 L 8,8" Stroke="#25FFFFFF" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Top"/>
                                                        <Path Data="M 0,0 L 0,8 L 8,8" Stroke="#25FFFFFF" StrokeThickness="1" HorizontalAlignment="Left" VerticalAlignment="Bottom"/>
                                                        <Path Data="M 0,8 L 8,8 L 8,0" Stroke="#25FFFFFF" StrokeThickness="1" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                                                        <!-- Faint center crosshair -->
                                                        <Path Data="M -6,0 L 6,0 M 0,-6 L 0,6" Stroke="#15FFFFFF" StrokeThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Timecode HUD overlay on top-left -->
                                                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12,10" Background="#99000000" CornerRadius="4" Padding="8,3" BorderBrush="#3000E5FF" BorderThickness="1"
                                                        Visibility="{Binding HasSelectedCue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding PreviewTimecodeText}" Foreground="#00E5FF" FontSize="10" FontWeight="SemiBold" FontFamily="Consolas, Segoe UI"/>
                                                </Border>

                                                <!-- Style Details HUD overlay on top-right -->
                                                <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="12,10" Background="#99000000" CornerRadius="4" Padding="8,3" BorderBrush="#20FFFFFF" BorderThickness="1"
                                                        Visibility="{Binding HasSelectedCue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding ActiveStyleDetails}" Foreground="{StaticResource TextMuted}" FontSize="10" FontFamily="Segoe UI Variable, Segoe UI"/>
                                                </Border>

                                                <!-- Empty State when no cue is selected -->
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Visibility="{Binding HasSelectedCue, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                    <ui:SymbolIcon Symbol="MoviesAndTv24" FontSize="34" Foreground="#2A3545" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                                                    <TextBlock Text="LIVE CINEMA VIEWPORT" Foreground="#3A4659" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold"/>
                                                    <TextBlock Text="Pilih baris subtitle untuk melihat preview styling secara real-time" Foreground="#3A4659" HorizontalAlignment="Center" FontSize="11" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <!-- Authentic Cinema Outlined Subtitle Element -->
                                                <controls:OutlinedTextBlock
                                                    Visibility="{Binding HasSelectedCue, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                    Text="{Binding ElementName=CueRawTextBox, Path=Text}"
                                                    Fill="{Binding PreviewPrimaryBrush}"
                                                    Stroke="{Binding PreviewOutlineBrush}"
                                                    StrokeThickness="{Binding PreviewOutlineThickness}"
                                                    ShadowColor="{Binding PreviewShadowColor}"
                                                    ShadowDepth="{Binding PreviewShadowDepth}"
                                                    FontFamily="{Binding PreviewFontFamily}"
                                                    FontSize="{Binding PreviewFontSize}"
                                                    FontWeight="{Binding PreviewFontWeight}"
                                                    FontStyle="{Binding PreviewFontStyle}"
                                                    TextAlignment="{Binding PreviewTextAlignment}"
                                                    VerticalAlignment="Stretch"
                                                    HorizontalAlignment="Stretch"
                                                    Margin="16,10"/>

                                                <!-- Subtle Cinema Viewport Bottom Letterbox Bar -->
                                                <Border VerticalAlignment="Bottom" Height="2" Background="#18FFFFFF" HorizontalAlignment="Stretch"/>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ========================================== -->
            <!-- TAB 2: MKV SUBTITLE EXTRACTOR VIEW         -->
            <!-- ========================================== -->
            <TabItem DataContext="{Binding ExtractorVm}">
                <Grid Margin="38,22,38,22">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Input Selection -->
                        <RowDefinition Height="*"/>    <!-- Track & Font Lists -->
                        <RowDefinition Height="Auto"/> <!-- 3 Modular Output Mode Cards -->
                        <RowDefinition Height="Auto"/> <!-- Progress & Logs -->
                        <RowDefinition Height="Auto"/> <!-- Action Buttons -->
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="🎬 MKV Subtitle Extractor &amp; Demuxer" FontSize="22" FontWeight="Bold" Foreground="{StaticResource AccentPurple}"/>
                            <TextBlock Text="Ekstrak subtitle (SRT, ASS, VTT, PGS) dan font langsung dari file video MKV menggunakan MKVToolNix Engine." FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>

                    <!-- Input File / Folder Selection Dropzone -->
                    <ui:Card Grid.Row="1" Padding="18,14" Margin="0,0,0,14" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Source MKV:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,14,0"/>
                            <ui:TextBox Grid.Column="1" Text="{Binding InputPath, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,4"/>
                            <ui:Button Grid.Column="2" Content="Pilih File..." Command="{Binding BrowseInputCommand}" Appearance="Primary" Margin="10,0,0,0" Padding="16,7" Icon="{ui:SymbolIcon Symbol=FolderOpen24}"/>
                        </Grid>
                    </ui:Card>

                    <!-- Subtitle Tracks & Attachments Tabbed DataGrid -->
                    <Grid Grid.Row="2" Margin="0,0,0,14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Content Switcher Tabs (Subtitles vs Fonts) -->
                        <Border Grid.Row="0" Margin="0,0,0,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="📝 Track Subtitle Terdeteksi"
                                                 IsChecked="{Binding SelectedContentTab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=0, FallbackValue=True}"
                                                 GroupName="ContentTabGroup" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12" Margin="0,0,20,0"/>
                                    <RadioButton Content="🔤 Lampiran Font Terdeteksi"
                                                 IsChecked="{Binding SelectedContentTab, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=1}"
                                                 GroupName="ContentTabGroup" Foreground="{StaticResource TextPrimary}" FontWeight="Bold" FontSize="12"/>
                                </StackPanel>

                                <!-- Subtitle Selection Actions -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Visibility="{Binding SelectedContentTab, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=0, FallbackValue=Visible}">
                                    <ui:Button Content="✓ Pilih Semua Track" Command="{Binding SelectAllTracksCommand}" Padding="10,4" Margin="0,0,6,0" FontSize="11"/>
                                    <ui:Button Content="✗ Batalkan Semua" Command="{Binding DeselectAllTracksCommand}" Padding="10,4" FontSize="11"/>
                                </StackPanel>

                                <!-- Font Selection Actions -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                            Visibility="{Binding SelectedContentTab, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=1, FallbackValue=Collapsed}">
                                    <ui:Button Content="✓ Pilih Semua Font" Command="{Binding SelectAllFontsCommand}" Padding="10,4" Margin="0,0,6,0" FontSize="11"/>
                                    <ui:Button Content="✗ Batalkan Semua" Command="{Binding DeselectAllFontsCommand}" Padding="10,4" FontSize="11"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Tab 1: Subtitles DataGrid -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ScannedTracks}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  Background="{StaticResource BgDark}" Foreground="{StaticResource TextPrimary}"
                                  RowBackground="{x:Null}" AlternatingRowBackground="{x:Null}"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderDark}" BorderBrush="{StaticResource BorderDark}" HeadersVisibility="Column"
                                  RowHeight="34" FontSize="12" SelectionUnit="FullRow"
                                  PreviewKeyDown="OnDataGridPreviewKeyDown"
                                  Visibility="{Binding SelectedContentTab, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=0, FallbackValue=Visible}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource BgCardElevated}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#0D0D11"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="BorderThickness" Value="4,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <EventSetter Event="MouseLeftButtonUp" Handler="OnTrackRowMouseLeftButtonUp"/>
                                    <Style.Triggers>
                                        <!-- Highlight row when subtitle track is selected (IsSelected == True) -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#4C1D95"/>
                                            <Setter Property="BorderBrush" Value="#A855F7"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <!-- Unselected state -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="Background" Value="#0D0D11"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                        </DataTrigger>
                                        <!-- Mouse hover on unselected row -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding IsSelected}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#22222E"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </MultiDataTrigger>
                                        <!-- Mouse hover on selected row -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#5B21B6"/>
                                            <Setter Property="BorderBrush" Value="#C084FC"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Ekstrak" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Track ID" Binding="{Binding Id}" Width="75" IsReadOnly="True" FontFamily="Consolas"/>
                                <DataGridTextColumn Header="Format / Codec" Binding="{Binding Codec}" Width="160" IsReadOnly="True" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Bahasa" Binding="{Binding Language}" Width="90" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Default" Binding="{Binding IsDefault}" Width="75" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Forced" Binding="{Binding IsForced}" Width="75" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Nama Track" Binding="{Binding TrackName}" Width="*" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Tab 2: Fonts DataGrid -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding ScannedFontItems}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  Background="{StaticResource BgDark}" Foreground="{StaticResource TextPrimary}"
                                  RowBackground="{x:Null}" AlternatingRowBackground="{x:Null}"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderDark}" BorderBrush="{StaticResource BorderDark}" HeadersVisibility="Column"
                                  RowHeight="34" FontSize="12" SelectionUnit="FullRow"
                                  PreviewKeyDown="OnDataGridPreviewKeyDown"
                                  Visibility="{Binding SelectedContentTab, Converter={StaticResource EnumToVisibilityConverter}, ConverterParameter=1, FallbackValue=Collapsed}">
                            <DataGrid.Resources>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="{StaticResource BgCardElevated}"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondary}"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                </Style>
                            </DataGrid.Resources>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="#0D0D11"/>
                                    <Setter Property="Foreground" Value="#94A3B8"/>
                                    <Setter Property="BorderThickness" Value="4,0,0,1"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <EventSetter Event="MouseLeftButtonUp" Handler="OnFontRowMouseLeftButtonUp"/>
                                    <Style.Triggers>
                                        <!-- Highlight row when font item is selected (IsSelected == True) -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="Background" Value="#4C1D95"/>
                                            <Setter Property="BorderBrush" Value="#A855F7"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <!-- Unselected state -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="False">
                                            <Setter Property="Background" Value="#0D0D11"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderDark}"/>
                                            <Setter Property="Foreground" Value="#94A3B8"/>
                                            <Setter Property="FontWeight" Value="Normal"/>
                                        </DataTrigger>
                                        <!-- Mouse hover on unselected row -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding IsSelected}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#22222E"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </MultiDataTrigger>
                                        <!-- Mouse hover on selected row -->
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Path=IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding IsSelected}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Background" Value="#5B21B6"/>
                                            <Setter Property="BorderBrush" Value="#C084FC"/>
                                            <Setter Property="Foreground" Value="#FFFFFF"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,5"/>
                                    <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="Transparent" BorderThickness="0" Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="{Binding RelativeSource={RelativeSource AncestorType=DataGridRow}, Path=Foreground}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Ekstrak" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Cursor="Hand"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="65" IsReadOnly="True" FontFamily="Consolas"/>
                                <DataGridTextColumn Header="Nama File Font" Binding="{Binding FileName}" Width="*" IsReadOnly="True" FontWeight="SemiBold"/>
                                <DataGridTextColumn Header="Tipe MIME" Binding="{Binding ContentType}" Width="160" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Ukuran" Binding="{Binding FormattedSize}" Width="105" IsReadOnly="True"/>
                                <DataGridTextColumn Header="Deskripsi" Binding="{Binding Description}" Width="180" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Output Options: 3 Distinct Modular Cards -->
                    <ui:Card Grid.Row="3" Padding="18,14" Margin="0,0,0,14" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderDark}">
                        <StackPanel>
                            <TextBlock Text="PILIHAN FORMAT &amp; TARGET EKSTRAKSI:" FontWeight="Bold" FontSize="11" Foreground="{StaticResource AccentPrimary}" Margin="0,0,0,12"/>

                            <!-- 3 Mode Cards -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Card 1: Standalone Subtitles -->
                                <Border Grid.Column="0" Background="{StaticResource BgPanel}" CornerRadius="8" Padding="14,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                    <StackPanel>
                                        <RadioButton Content="📄 Subtitle Standalone"
                                                     IsChecked="{Binding OutputMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=0, FallbackValue=True}"
                                                     GroupName="ExtractionModeGroup" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"
                                                     Checked="OnModeStandaloneChecked"/>
                                        <TextBlock Text="Ekstrak track terpilih menjadi file subtitle individual terpisah (.srt / .ass / .vtt / .sup)."
                                                   Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="20,0,0,10"/>
                                        
                                        <Border Background="{StaticResource BgDark}" CornerRadius="4" Padding="10,7" Margin="20,0,0,0">
                                            <CheckBox Content="Ekstrak font lampiran ke ./fonts/"
                                                      IsChecked="{Binding ExtractFonts}"
                                                      IsEnabled="{Binding OutputMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=0}"
                                                      Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2: Pure MKS Container -->
                                <Border Grid.Column="2" Background="{StaticResource BgPanel}" CornerRadius="8" Padding="14,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                    <StackPanel>
                                        <RadioButton Content="📦 Kontainer .mks Native"
                                                     IsChecked="{Binding OutputMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=1}"
                                                     GroupName="ExtractionModeGroup" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"
                                                     Checked="OnModeMksChecked"/>
                                        <TextBlock Text="Kemas seluruh track terpilih ke dalam satu file container Matroska Subtitle (.mks)."
                                                   Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="20,0,0,10"/>
                                        
                                        <Border Background="{StaticResource BgDark}" CornerRadius="4" Padding="10,7" Margin="20,0,0,0">
                                            <CheckBox Content="Sematkan font ke dalam file .mks"
                                                      IsChecked="{Binding ExtractFonts}"
                                                      IsEnabled="{Binding OutputMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=1}"
                                                      Foreground="{StaticResource TextPrimary}" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Embedded Fonts Only -->
                                <Border Grid.Column="4" Background="{StaticResource BgPanel}" CornerRadius="8" Padding="14,12" BorderBrush="{StaticResource BorderDark}" BorderThickness="1">
                                    <StackPanel>
                                        <RadioButton Content="🔤 Ekstrak Font Saja"
                                                     IsChecked="{Binding OutputMode, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=2}"
                                                     GroupName="ExtractionModeGroup" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" Margin="0,0,0,5"
                                                     Checked="OnModeFontsChecked"/>
                                        <TextBlock Text="Hanya ekstrak font lampiran terpilih (TTF/OTF) ke folder ./fonts/ tanpa subtitle."
                                                   Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap" Margin="20,0,0,10"/>
                                        
                                        <Border Background="{StaticResource BgDark}" CornerRadius="4" Padding="10,7" Margin="20,0,0,0">
                                            <TextBlock Text="Font lampiran akan diekstrak ke ./fonts/" Foreground="{StaticResource AccentPrimary}" FontSize="11"/>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Output Folder -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Folder Output:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,14,0"/>
                                <ui:TextBox Grid.Column="1" Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" Height="36" Padding="10,4"/>
                                <ui:Button Grid.Column="2" Content="Pilih Folder..." Command="{Binding BrowseOutputFolderCommand}" Margin="10,0,0,0" Padding="14,7" Icon="{ui:SymbolIcon Symbol=Folder24}"/>
                                <ui:Button Grid.Column="3" Content="Buka Folder" Command="{Binding OpenOutputFolderCommand}" Margin="6,0,0,0" Padding="12,7" Icon="{ui:SymbolIcon Symbol=Open24}"/>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- Progress & Status -->
                    <StackPanel Grid.Row="4" Margin="0,0,0,14">
                        <Grid Margin="0,0,0,6">
                            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource AccentPrimary}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding ProgressValue, StringFormat='{}{0}%'}" HorizontalAlignment="Right" Foreground="{StaticResource TextSecondary}" FontWeight="Bold"/>
                        </Grid>
                        <ProgressBar Value="{Binding ProgressValue}" Maximum="100" Height="8" Background="{StaticResource BgPanel}" Foreground="{StaticResource AccentPurple}" BorderThickness="0"/>
                    </StackPanel>

                    <!-- Bottom Action Buttons -->
                    <Grid Grid.Row="5" Margin="0,4,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <ui:Button Content="Buka Hasil di Editor" Command="{Binding OpenLastInEditorCommand}" Appearance="Secondary" FontWeight="Bold" Padding="16,9" Icon="{ui:SymbolIcon Symbol=Edit24}" Margin="0,0,8,0"/>
                            <ui:Button Content="Buka Folder Output" Command="{Binding OpenOutputFolderCommand}" Padding="14,9" Icon="{ui:SymbolIcon Symbol=Folder24}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Content="Mulai Ekstraksi" Command="{Binding ExtractCommand}" Appearance="Primary" FontWeight="Bold" Padding="26,9" FontSize="13" Icon="{ui:SymbolIcon Symbol=Flash24}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 3. Bottom Status Bar -->
        <StatusBar Grid.Row="2" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDark}" BorderThickness="0,1,0,0" Foreground="{StaticResource TextSecondary}" Padding="16,6">
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource AccentGreen}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold"/>
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="MKS Subtitle Studio | Windows 11 Fluent UI" Foreground="{StaticResource TextMuted}" FontSize="11"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</ui:FluentWindow>
